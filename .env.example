# HireOnto AI: every setting, with dummy values. Copy to .env for local dev (.env is git-ignored).
# In production these come from Cloud Run env vars / Secret Manager (see README "Deploy on Google Cloud").

# ---- Runtime ----
APP_ENV=development                   # "production" = strict startup checks (the Docker image defaults to production)
LOG_LEVEL=INFO                        # DEBUG also logs transcript snippets: never use DEBUG in production
MAX_BODY_BYTES=5242880                # API request body limit (5 MB)
PORT=8000                             # set by Cloud Run / Railway; local default 8000

# ---- Service-to-service auth (both services) ----
JWT_INTERNAL_SECRET=replace-with-the-same-random-32+-byte-secret-as-the-backend
BACKEND_URL=http://localhost:3001     # production: the backend's public https URL

# ---- LLM (both services) ----
LLM_PROVIDER=gemini                   # gemini | groq | claude
LLM_FALLBACKS=groq,gemini,claude      # tried in order when the primary errors; providers without a key are skipped
LLM_TIMEOUT_SECS=120
LLM_MAX_RETRIES=2                     # SDK retries on 429/5xx/connection errors, with backoff
GEMINI_API_KEY=dummy-gemini-key
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=dummy-groq-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VOICE_MODEL=openai/gpt-oss-20b
ANTHROPIC_API_KEY=dummy-anthropic-key
CLAUDE_MODEL=claude-opus-5-5
AI_FAKE_MODE=false                    # scripted answers for offline dev; refused in production

# ---- Files: S3-compatible bucket (both services) ----
# Local: MinIO. Production: Cloudflare R2 -> S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=hiremind
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_CONNECT_TIMEOUT_SECS=5
S3_READ_TIMEOUT_SECS=30

# ---- LiveKit (ai-agent required; ai-api only reports voiceReady) ----
LIVEKIT_URL=ws://localhost:7880       # production: wss://<project>.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
AGENT_NAME=hiremind-interviewer       # must equal the backend's LIVEKIT_AGENT_NAME

# ---- Speech (ai-agent) ----
STT_PROVIDER=groq                     # cartesia | groq | openai
TTS_PROVIDER=cartesia                 # cartesia | openai
STT_FALLBACKS=cartesia,groq,openai
TTS_FALLBACKS=cartesia,openai
CARTESIA_API_KEY=dummy-cartesia-key
CARTESIA_STT_MODEL=ink-2
CARTESIA_TURN_END_TIMEOUT_MS=720
CARTESIA_TTS_MODEL=sonic-3
CARTESIA_VOICE=f786b574-daa5-4673-aa0c-cbe3e8534c02
OPENAI_API_KEY=dummy-openai-key
STT_MODEL=gpt-4o-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# ---- Audio and turn taking (ai-agent) ----
NOISE_FILTER=true
VAD_START_SECS=0.2
VAD_STOP_SECS=0.55
VAD_CONFIDENCE=0.6
TURN_DETECTOR=true
ENDPOINTING_MIN_DELAY=0.4
ENDPOINTING_MAX_DELAY=2.5
REJOIN_GRACE_SECS=60
